{
  "name": "json2type",
  "version": "1.0.0",
  "description": "Generate TypeScript Type Definition from JSON.",
  "source": "index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vite build"
  },
  "keywords": [
    "TypeScript",
    "JSON",
    "api",
    "response"
  ],
  "author": {
    "name": "KotoriK",
    "url": "https://www.github.com/KotoriK/"
  },
  "repository": {
    "url": "https://www.github.com/KotoriK/json2type"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "change-case": "^5.4",
    "diff": "^7.0.0",
    "pluralize": "^8.0.0",
    "typescript": "^4.5.5"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/pluralize": "^0.0.33",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}